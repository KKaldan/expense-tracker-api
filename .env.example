NODE_ENV=development
PORT=3000

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/expense_tracker

# JWT — use a long random string for JWT_SECRET (e.g. openssl rand -hex 32)
JWT_SECRET=replace-with-256-bit-random-secret
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY_DAYS=7

# CORS — comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:3000

# Number of reverse proxies in front of the API (0 = none / direct exposure).
# Set to 1 behind a single load balancer so rate limiting sees real client IPs.
TRUST_PROXY=0
